# Copy this file to .env and replace the values with your credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Splitwise OAuth (used by src/lib/splitwiseAuth.ts)
VITE_SPLITWISE_CLIENT_ID=your-splitwise-client-id
# Optional: defaults to `${origin}/splitwise-callback` when unset
VITE_SPLITWISE_REDIRECT_URI=https://your-app.example.com/splitwise-callback

# Optional: public web URL used in invite/share links from the native app
# (the app's own origin is https://localhost). Defaults to https://divido-next.vercel.app
VITE_PUBLIC_APP_URL=https://your-app.example.com
